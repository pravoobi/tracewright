# ─── LLM API ──────────────────────────────────────────────────────────────────
# NOTE: this is the PRODUCT runtime key (Planner + classifier calls).
# Your Claude Code / Claude Max subscription is separate and not needed here.
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (override per use-case via config)
PLANNER_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_testing
# Embedding vector dimension — must match the model you deploy.
# Changing this after data is written requires a migration + re-embed.
EMBEDDING_DIM=1536

# ─── Object storage (MinIO) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-testing
MINIO_SECURE=false

# ─── Redis / arq ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Langfuse (observability) ─────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3001

# ─── Parsing backend ──────────────────────────────────────────────────────────
# "local" (Docling) or "cloud" (Mistral OCR / Gemini Flash — must accept data flow)
PARSING_BACKEND=local

# ─── Auth session storage ─────────────────────────────────────────────────────
# AES-256 key for encrypting storage-state files at rest (base64-encoded 32 bytes)
AUTH_SESSION_ENCRYPTION_KEY=CHANGE_ME_generate_with_secrets_module

# ─── Confidence thresholds ────────────────────────────────────────────────────
# Chunks above this are auto-approved; below go to review queue
CONFIDENCE_AUTO_APPROVE_THRESHOLD=0.85

# ─── Per-tenant LLM cost guard ────────────────────────────────────────────────
# Daily USD budget per tenant; 0 = unlimited (dev default)
DEFAULT_TENANT_DAILY_LLM_BUDGET_USD=0

# ─── Dev tenant API key (frontend + scripts/curl testing) ─────────────────────
# Generate with: uv run --project backend python scripts/generate-tenant-api-key.py <tenant_id>
DEV_TENANT_API_KEY=
