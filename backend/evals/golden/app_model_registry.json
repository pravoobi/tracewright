{
  "CartPage": {
    "url_pattern": "http://localhost:4000/cart",
    "locators": {
      "discountCodeInput": "page.getByRole(\"textbox\", { name: \"Discount code\" })",
      "applyDiscountButton": "page.getByRole(\"button\", { name: \"Apply discount code\" })",
      "proceedToCheckoutButton": "page.getByRole(\"button\", { name: \"Proceed to checkout\" })",
      "orderTotal": "page.getByTestId(\"order-total\")",
      "discountSummary": "page.getByTestId(\"discount-summary\")",
      "widgetQuantityInput": "page.getByRole(\"spinbutton\", { name: \"Quantity for Widget\" })",
      "gadgetQuantityInput": "page.getByRole(\"spinbutton\", { name: \"Quantity for Gadget\" })",
      "stickerQuantityInput": "page.getByRole(\"spinbutton\", { name: \"Quantity for Sticker\" })",
      "updateCartButton": "page.getByRole(\"button\", { name: \"Update cart\" })",
      "errorAlert": "page.getByRole(\"alert\")"
    },
    "locator_strategies": {
      "discountCodeInput": "role",
      "applyDiscountButton": "role",
      "proceedToCheckoutButton": "role",
      "orderTotal": "testid",
      "discountSummary": "testid",
      "widgetQuantityInput": "role",
      "gadgetQuantityInput": "role",
      "stickerQuantityInput": "role",
      "updateCartButton": "role",
      "errorAlert": "role"
    },
    "warnings": [],
    "suggestions": {}
  },
  "CheckoutPage": {
    "url_pattern": "http://localhost:4000/checkout",
    "locators": {
      "placeOrderButton": "page.getByRole(\"button\", { name: \"Place order\" })",
      "orderTotal": "page.getByTestId(\"order-total\")"
    },
    "locator_strategies": {
      "placeOrderButton": "role",
      "orderTotal": "testid"
    },
    "warnings": [],
    "suggestions": {}
  }
}