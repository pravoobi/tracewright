{
  "CartPage": {
    "url_pattern": "http://localhost:4000/cart",
    "locators": {
      "discountCodeInput": "page.getByRole(\"textbox\", { name: \"Discount code\" })",
      "applyDiscountButton": "page.getByRole(\"button\", { name: \"Apply discount code\" })",
      "proceedToCheckoutButton": "page.getByRole(\"button\", { name: \"Proceed to checkout\" })",
      "orderTotal": "page.getByTestId(\"order-total\")",
      "discountSummary": "page.getByTestId(\"discount-summary\")"
    },
    "locator_strategies": {
      "discountCodeInput": "role",
      "applyDiscountButton": "role",
      "proceedToCheckoutButton": "role",
      "orderTotal": "testid",
      "discountSummary": "testid"
    },
    "warnings": [],
    "suggestions": {}
  },
  "CheckoutPage": {
    "url_pattern": "http://localhost:4000/checkout",
    "locators": {
      "placeOrderButton": "page.getByRole(\"button\", { name: \"Place order\" })",
      "orderTotal": "page.getByTestId(\"order-total\")"
    },
    "locator_strategies": {
      "placeOrderButton": "role",
      "orderTotal": "testid"
    },
    "warnings": [],
    "suggestions": {}
  }
}